# Backend Server Environment Configuration
PORT=5000
NODE_ENV=development

# Reverse proxies in front of the app (Render, Railway, Nginx, Cloudflare...).
# Leave empty: 1 when NODE_ENV=production, off in development.
# Set 2 if you have two (for example Cloudflare in front of Render). Set false if users reach Node directly.
TRUST_PROXY=

# MongoDB Connection String (Atlas Cluster or local mongod)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_domain>.mongodb.net/<db_name>?retryWrites=true&w=majority

# JWT Signing Secret (Generate using: openssl rand -base64 48)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Credentials)
GOOGLE_CLIENT_ID=—

# Server-Authoritative Primary Admin Google Email (Fails closed on missing or placeholder —)
PRIMARY_ADMIN_GOOGLE_EMAIL=—

# Break-Glass Legacy Password Administration (Disabled by default; only exact primary admin match if true)
ENABLE_LEGACY_ADMIN_LOGIN=false

# Optional Cloudinary Storage Configuration for Student Documents
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Scholarly Launch Feature Flags
PAPER_SUMMARIZER_ENABLED=true
INSTITUTION_ANALYTICS_ENABLED=true

# Federated Scholarly Providers (Optional API Keys for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_optional

# Automated Email Notification Service (SMTP)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="The Thesis Archive <your_email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=sahaaniruddha2004@gmail.com

# ---------------------------------------------------------------------------
# Added with the release update. Every line below is optional unless it says REQUIRED.
# ---------------------------------------------------------------------------

# Contact address sent to Unpaywall for the "Find a free PDF" button (their rule).
# Without it the button says the finder is not switched on.
UNPAYWALL_EMAIL=

# Optional CORE API key (free at core.ac.uk/services/api). Without it CORE still works, at a lower rate.
CORE_API_KEY=

# Reading paper PDFs for Limitations / Future work. Needs: npm install pdfjs-dist  (in the backend folder)
# Largest PDF downloaded (MB), time limit (ms) and pages read before looking for the end sections.
FULLTEXT_MAX_MB=15
FULLTEXT_TIMEOUT_MS=20000
FULLTEXT_MAX_PAGES=75
# Reading stops when the server's memory has grown by this many MB for one PDF (protects small servers).
FULLTEXT_MAX_MEMORY_MB=400

# Largest thesis PDF a student may upload with the deposit form (MB, 1 to 50). Uses the Cloudinary account above.
THESIS_PDF_MAX_MB=20

# Copying thesis records from university repositories (scripts/harvestRepository.js).
# REQUIRED for that script: an address the library can write to if they have questions.
HARVEST_CONTACT_EMAIL=
# Your public site address, shown to the repository in each request.
HARVEST_SITE_URL=

# General request limit per minute, counted per signed-in member (per address for visitors). Default 180.
API_RATE_LIMIT_PER_MINUTE=
