# Backend Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster or local mongod)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_domain>.mongodb.net/<db_name>?retryWrites=true&w=majority

# JWT Signing Secret (Generate using: openssl rand -base64 48)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Credentials)
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com

# Optional Cloudinary Storage Configuration for Student Documents
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional initial admin provisioning seed credentials (used only by npm run create-admin)
ADMIN_EMAIL=admin@thesis.org
ADMIN_PASSWORD=replace_with_secure_admin_password_min_10_chars
ADMIN_NAME=Editorial Board Administrator
